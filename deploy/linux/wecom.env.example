# 企业微信自建应用配置模板（脱敏，可安全提交 git）
#
# 用法：install.sh 会把它复制为 /kpi/wecom.env 并 chmod 600；
#      填写下面的 WECOM_* 后执行 systemctl restart kpi-api 生效。
#      留空则企业微信功能不启用，站内账号密码登录不受任何影响。
#
# 获取位置：企业微信管理后台 → 应用管理 → 自建 → 你的应用
# 注意：本文件是模板，只放占位符，切勿把真实 Secret 写进来。

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 站点对外访问地址，回调与扫码跳转都以它为前缀，例如 https://kpi.example.com
WECOM_BASE_URL=

# 通讯录/成员变更回调（可选，不启用不影响扫码登录）：
# Token 自行定义，EncodingAESKey 由后台随机生成（43 位）
# WECOM_CALLBACK_TOKEN=
# WECOM_CALLBACK_AES_KEY=

# JWT_SECRET 不要写在这里：install.sh 首次安装时会自动生成并追加到 /kpi/wecom.env，
# 手动留一条空的 JWT_SECRET= 会让脚本误判为「已配置」，导致全站使用空签名密钥。
